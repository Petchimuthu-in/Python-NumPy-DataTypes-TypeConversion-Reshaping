import numpy as np

arr = np.array([10, 20, 30, 40, 50, 60])
print("Original Array:", arr)
print("Data Type:", arr.dtype)

float_arr = arr.astype(float)
print("Float Array:", float_arr)
print("Data Type:", float_arr.dtype)

reshape_arr = arr.reshape(2, 3)
print("Reshaped Array:")
print(reshape_arr)
print("Shape:", reshape_arr.shape)

reshape_arr2 = arr.reshape(3, 2)
print("3 x 2 Array:")
print(reshape_arr2)
print("Shape:", reshape_arr2.shape)
